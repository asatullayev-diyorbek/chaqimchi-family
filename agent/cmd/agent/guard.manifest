<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" processorArchitecture="amd64" name="ChaqimchiAI.Guard.Service" type="win32"/>
  <description>ChaqimchiAI Guard Service — Parental Control Client</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- requireAdministrator only matters for a direct/shell launch (the
             UAC consent prompt is an Explorer/AIS concept) — it does not
             affect the SCM starting this exe as a service (SYSTEM, no UAC
             involved) or the service spawning -foreground-reporter into the
             user's session via CreateProcessAsUser (also not a shell
             launch). It exists so Add/Remove Programs' "Uninstall" button —
             which runs this exe directly with -uninstall, and needs admin
             rights to delete the service — gets its UAC prompt automatically
             instead of failing partway through with an access-denied error. -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
